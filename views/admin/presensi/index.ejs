<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/tailwind.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-dark-900 min-h-screen" style="background:#1a1d20;">
    <%
        const q = (filters && filters.q) ? filters.q : '';
        const pageInfo = pagination || { page: 1, totalPages: 1, hasPrev: false, hasNext: false, prevPage: 1, nextPage: 1, startItem: 0, endItem: 0, totalItems: 0 };
        const employeeList = employees || [];
        const filterType = (filters && filters.filterType) || 'month';
        const today = new Date();
        const defaultMonth = (today.getMonth() + 1);
        const defaultYear = today.getFullYear();
        const queryString = (() => {
            const sp = new URLSearchParams();
            if (q) sp.set('q', q);
            if (filters && filters.filterType) sp.set('filterType', filters.filterType);
            if (filters && filters.tanggal) sp.set('tanggal', filters.tanggal);
            if (filters && filters.startDate) sp.set('startDate', filters.startDate);
            if (filters && filters.endDate) sp.set('endDate', filters.endDate);
            if (filters && filters.month) sp.set('month', filters.month);
            if (filters && filters.year) sp.set('year', filters.year);
            const s = sp.toString();
            return s ? '&' + s : '';
        })();
    %>
    <%- include('../../partials/navbar') %>
    <div class="pt-20">
        <div class="flex flex-col lg:flex-row">
            <%- include('../../partials/sidebar', { currentPage: 'presensi', admin: admin }) %>
            <div class="flex-1 lg:ml-64 p-4 sm:p-6 lg:p-8">
                <div class="mb-6 flex items-center justify-between gap-3">
                    <div class="flex items-center space-x-3">
                        <i class="fas fa-calendar-check text-brown-400 text-xl"></i>
                        <div>
                            <h1 class="text-3xl font-bold text-white">Daftar Presensi</h1>
                            <p class="text-brown-300 text-sm">Ringkasan presensi karyawan per periode — klik <span class="font-semibold text-brown-200">Detail</span> untuk lihat riwayat lengkap.</p>
                        </div>
                    </div>
                    <button type="button" onclick="window.location.href='/admin/presensi/export' + window.location.search"
                            class="shrink-0 bg-green-600 hover:bg-green-500 text-white px-4 py-2 rounded-lg transition duration-200 text-sm shadow-lg">
                        <i class="fas fa-file-excel mr-2"></i>Export Excel
                    </button>
                </div>

                <!-- Filter & Search -->
                <div class="mb-4 rounded-xl border border-brown-700/40 bg-dark-800 p-4">
                    <form method="GET" action="/admin/presensi" class="space-y-3">
                        <div class="grid grid-cols-1 gap-3 sm:grid-cols-4">
                            <div>
                                <label class="block text-xs text-brown-300 mb-1">Tipe Filter</label>
                                <select name="filterType" onchange="toggleFilterFields(this.value)" id="filterType"
                                    class="w-full rounded-lg border border-brown-700/40 bg-dark-700 px-3 py-2 text-white">
                                    <option value="date" <%= filterType === 'date' ? 'selected' : '' %>>Tanggal</option>
                                    <option value="range" <%= filterType === 'range' ? 'selected' : '' %>>Rentang</option>
                                    <option value="month" <%= filterType === 'month' ? 'selected' : '' %>>Bulan</option>
                                    <option value="year" <%= filterType === 'year' ? 'selected' : '' %>>Tahun</option>
                                </select>
                            </div>
                            <div id="field-date" class="<%= filterType === 'date' ? '' : 'hidden' %>">
                                <label class="block text-xs text-brown-300 mb-1">Tanggal</label>
                                <input type="date" name="tanggal" value="<%= (filters && filters.tanggal) || '' %>"
                                    class="w-full rounded-lg border border-brown-700/40 bg-dark-700 px-3 py-2 text-white">
                            </div>
                            <div id="field-range" class="<%= filterType === 'range' ? 'grid grid-cols-2 gap-2 sm:col-span-2' : 'hidden' %>">
                                <div>
                                    <label class="block text-xs text-brown-300 mb-1">Mulai</label>
                                    <input type="date" name="startDate" value="<%= (filters && filters.startDate) || '' %>"
                                        class="w-full rounded-lg border border-brown-700/40 bg-dark-700 px-3 py-2 text-white">
                                </div>
                                <div>
                                    <label class="block text-xs text-brown-300 mb-1">Akhir</label>
                                    <input type="date" name="endDate" value="<%= (filters && filters.endDate) || '' %>"
                                        class="w-full rounded-lg border border-brown-700/40 bg-dark-700 px-3 py-2 text-white">
                                </div>
                            </div>
                            <div id="field-month" class="<%= filterType === 'month' ? 'grid grid-cols-2 gap-2' : 'hidden' %>">
                                <div>
                                    <label class="block text-xs text-brown-300 mb-1">Bulan</label>
                                    <select name="month" class="w-full rounded-lg border border-brown-700/40 bg-dark-700 px-3 py-2 text-white">
                                        <% const months = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember']; %>
                                        <% months.forEach((m, i) => { %>
                                            <option value="<%= i + 1 %>" <%= ((filters && filters.month) || defaultMonth) == (i + 1) ? 'selected' : '' %>><%= m %></option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs text-brown-300 mb-1">Tahun</label>
                                    <input type="number" name="year" value="<%= (filters && filters.year) || defaultYear %>" min="2020" max="2100"
                                        class="w-full rounded-lg border border-brown-700/40 bg-dark-700 px-3 py-2 text-white">
                                </div>
                            </div>
                            <div id="field-year" class="<%= filterType === 'year' ? '' : 'hidden' %>">
                                <label class="block text-xs text-brown-300 mb-1">Tahun</label>
                                <input type="number" name="year" value="<%= (filters && filters.year) || defaultYear %>" min="2020" max="2100"
                                    class="w-full rounded-lg border border-brown-700/40 bg-dark-700 px-3 py-2 text-white">
                            </div>
                            <div>
                                <label class="block text-xs text-brown-300 mb-1">Cari Karyawan</label>
                                <input type="text" name="q" value="<%= q %>" placeholder="Nama / NIK / jabatan"
                                    class="w-full rounded-lg border border-brown-700/40 bg-dark-700 px-3 py-2 text-white">
                            </div>
                        </div>
                        <div class="flex justify-end gap-2">
                            <a href="/admin/presensi" class="rounded-lg border border-brown-700/40 px-4 py-2 text-brown-200 hover:bg-dark-700 text-sm">Reset</a>
                            <button type="submit" class="rounded-lg bg-brown-600 px-4 py-2 text-white hover:bg-brown-500 text-sm">
                                <i class="fas fa-filter mr-1"></i>Terapkan
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Tabel List Karyawan -->
                <div class="overflow-hidden rounded-xl border border-brown-700/40 bg-dark-800">
                    <div class="flex flex-col gap-2 border-b border-brown-700/40 bg-dark-700 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
                        <div>
                            <div class="font-semibold text-white">Ringkasan Presensi Karyawan</div>
                            <div class="text-xs text-brown-300">Periode: <%= periodLabel %></div>
                        </div>
                        <div class="text-xs text-brown-300"><%= pageInfo.totalItems %> karyawan</div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-brown-700/40">
                            <thead class="bg-dark-700/60 text-brown-200">
                                <tr>
                                    <th class="px-4 py-3 text-left">Karyawan</th>
                                    <th class="px-4 py-3 text-left">Jabatan / Jadwal</th>
                                    <th class="px-4 py-3 text-center">Total Hadir</th>
                                    <th class="px-4 py-3 text-center">Terlambat</th>
                                    <th class="px-4 py-3 text-center">Belum Presensi</th>
                                    <th class="px-4 py-3 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-brown-700/30 text-brown-100">
                                <% if (employeeList.length === 0) { %>
                                    <tr><td colspan="6" class="px-4 py-10 text-center text-brown-300">Tidak ada karyawan yang cocok.</td></tr>
                                <% } %>
                                <% employeeList.forEach(k => { %>
                                    <tr class="hover:bg-dark-700/40">
                                        <td class="px-4 py-3">
                                            <div class="font-semibold text-white"><%= k.nama %></div>
                                            <div class="text-xs text-brown-300">NIK <%= k.nik %></div>
                                        </td>
                                        <td class="px-4 py-3">
                                            <div><%= k.nama_jabatan || '-' %></div>
                                            <div class="text-xs text-brown-300"><%= k.jadwal_kerja || k.nama_shift || 'Belum ada jadwal' %></div>
                                        </td>
                                        <td class="px-4 py-3 text-center">
                                            <span class="inline-flex items-center justify-center rounded-full bg-green-900/50 text-green-200 px-3 py-1 text-sm font-semibold">
                                                <%= k.total_hadir || 0 %>
                                            </span>
                                        </td>
                                        <td class="px-4 py-3 text-center">
                                            <span class="inline-flex items-center justify-center rounded-full <%= (k.total_terlambat || 0) > 0 ? 'bg-yellow-900/50 text-yellow-200' : 'bg-dark-700 text-brown-300' %> px-3 py-1 text-sm font-semibold">
                                                <%= k.total_terlambat || 0 %>
                                            </span>
                                        </td>
                                        <td class="px-4 py-3 text-center">
                                            <span class="inline-flex items-center justify-center rounded-full <%= (k.belum_presensi || 0) > 0 ? 'bg-red-900/50 text-red-200' : 'bg-dark-700 text-brown-300' %> px-3 py-1 text-sm font-semibold">
                                                <%= k.belum_presensi || 0 %>
                                            </span>
                                        </td>
                                        <td class="px-4 py-3 text-center">
                                            <a href="/admin/presensi/karyawan/<%= k.id %>?<%= (q ? 'q=' + encodeURIComponent(q) + '&' : '') %>filterType=<%= filterType %>&tanggal=<%= (filters && filters.tanggal) || '' %>&startDate=<%= (filters && filters.startDate) || '' %>&endDate=<%= (filters && filters.endDate) || '' %>&month=<%= (filters && filters.month) || '' %>&year=<%= (filters && filters.year) || '' %>"
                                               class="inline-flex items-center gap-2 rounded bg-brown-600 px-3 py-2 text-sm text-white hover:bg-brown-500">
                                                <i class="fas fa-eye"></i>Detail
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mt-4 flex flex-col gap-2 text-sm text-brown-300 sm:flex-row sm:items-center sm:justify-between">
                    <div>Menampilkan <%= pageInfo.startItem %>-<%= pageInfo.endItem %> dari <%= pageInfo.totalItems %> data</div>
                    <div class="flex items-center gap-2">
                        <a href="/admin/presensi?page=<%= pageInfo.prevPage %><%= queryString %>" class="rounded border border-brown-700/40 px-3 py-1 <%= pageInfo.hasPrev ? 'text-brown-200 hover:bg-dark-700' : 'pointer-events-none opacity-40 text-brown-500' %>">Prev</a>
                        <span class="text-brown-200">Hal <%= pageInfo.page %>/<%= pageInfo.totalPages %></span>
                        <a href="/admin/presensi?page=<%= pageInfo.nextPage %><%= queryString %>" class="rounded border border-brown-700/40 px-3 py-1 <%= pageInfo.hasNext ? 'text-brown-200 hover:bg-dark-700' : 'pointer-events-none opacity-40 text-brown-500' %>">Next</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function toggleFilterFields(type) {
            ['date', 'range', 'month', 'year'].forEach(t => {
                const el = document.getElementById('field-' + t);
                if (el) el.classList.add('hidden');
            });
            const active = document.getElementById('field-' + type);
            if (active) active.classList.remove('hidden');
        }
    </script>
</body>
</html>
