<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/tailwind.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-dark-900 min-h-screen" style="background:#1a1d20;">
    <%
        const typeLabel = (value) => {
            const normalized = String(value || '').toLowerCase();
            const labels = { cuti: 'Cuti', izin: 'Izin', sakit: 'Sakit' };
            return labels[normalized] || value || '-';
        };
        const categoryLabel = (value) => {
            const normalized = String(value || '').toLowerCase();
            const labels = {
                full_day: 'Seharian',
                half_day: 'Setengah Hari',
                hourly: 'Per Jam'
            };
            return labels[normalized] || value || '-';
        };
        const statusMeta = (status) => {
            const normalized = String(status || '').toLowerCase();
            if (['approved', 'disetujui'].includes(normalized)) {
                return { label: 'Disetujui', className: 'bg-green-900/60 text-green-200' };
            }
            return { label: normalized === 'ditolak_pengganti' ? 'Ditolak Pengganti' : 'Ditolak', className: 'bg-red-900/60 text-red-200' };
        };
        const formatDateTimeID = (value) => {
            if (!value) return '-';
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return String(value);
            return d.toLocaleString('id-ID', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });
        };
    %>
    <%- include('../../partials/navbar') %>
    <div class="pt-20">
        <div class="flex flex-col lg:flex-row">
            <%- include('../../partials/sidebar', { currentPage: 'manager-dashboard', admin: admin }) %>
            <div class="flex-1 lg:ml-64 p-4 sm:p-6 lg:p-8">
                <div class="mb-6">
                    <h1 class="text-3xl font-bold text-white">Dashboard Ringkas Tim</h1>
                    <p class="text-brown-300">Pantau status persetujuan harian secara cepat.</p>
                </div>

                <% if (messages.success && messages.success.length) { %>
                    <% messages.success.forEach(msg => { %><div class="mb-4 rounded-lg border border-green-700 bg-green-900/60 px-4 py-3 text-green-200"><%= msg %></div><% }) %>
                <% } %>
                <% if (messages.error && messages.error.length) { %>
                    <% messages.error.forEach(msg => { %><div class="mb-4 rounded-lg border border-red-700 bg-red-900/60 px-4 py-3 text-red-200"><%= msg %></div><% }) %>
                <% } %>

                <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
                    <div class="rounded-xl border border-yellow-700/40 bg-dark-800 p-4">
                        <p class="text-xs uppercase text-yellow-300">Menunggu Hari Ini</p>
                        <p class="mt-2 text-3xl font-bold text-white"><%= summary.pending_today %></p>
                    </div>
                    <div class="rounded-xl border border-green-700/40 bg-dark-800 p-4">
                        <p class="text-xs uppercase text-green-300">Disetujui Hari Ini</p>
                        <p class="mt-2 text-3xl font-bold text-white"><%= summary.approved_today %></p>
                    </div>
                    <div class="rounded-xl border border-red-700/40 bg-dark-800 p-4">
                        <p class="text-xs uppercase text-red-300">Ditolak Hari Ini</p>
                        <p class="mt-2 text-3xl font-bold text-white"><%= summary.rejected_today %></p>
                    </div>
                    <div class="rounded-xl border border-brown-700/40 bg-dark-800 p-4">
                        <p class="text-xs uppercase text-brown-300">Menunggu Total</p>
                        <p class="mt-2 text-3xl font-bold text-white"><%= summary.pending_total %></p>
                    </div>
                </div>

                <div class="overflow-hidden rounded-xl border border-brown-700/40 bg-dark-800">
                    <div class="border-b border-brown-700/40 bg-dark-700 px-4 py-3 text-brown-200 font-semibold">Persetujuan Terbaru</div>
                    <table class="min-w-full divide-y divide-brown-700/40">
                        <thead class="bg-dark-700/60 text-brown-200 text-xs uppercase">
                            <tr>
                                <th class="px-4 py-3 text-left">Karyawan</th>
                                <th class="px-4 py-3 text-left">Jenis</th>
                                <th class="px-4 py-3 text-left">Status</th>
                                <th class="px-4 py-3 text-left">Penyetuju</th>
                                <th class="px-4 py-3 text-left">Waktu</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-brown-700/30 text-brown-100">
                            <% if (!recentApprovals || recentApprovals.length === 0) { %>
                                <tr><td colspan="5" class="px-4 py-10 text-center text-brown-300">Belum ada riwayat persetujuan.</td></tr>
                            <% } %>
                            <% (recentApprovals || []).forEach(item => { %>
                                <% const meta = statusMeta(item.status); %>
                                <tr class="hover:bg-dark-700/40">
                                    <td class="px-4 py-3"><%= item.nama_karyawan %></td>
                                    <td class="px-4 py-3"><%= typeLabel(item.jenis) %> / <%= categoryLabel(item.kategori) %></td>
                                    <td class="px-4 py-3">
                                        <span class="rounded-full px-3 py-1 text-xs <%= meta.className %>"><%= meta.label %></span>
                                    </td>
                                    <td class="px-4 py-3"><%= item.approver_name || 'Admin' %></td>
                                    <td class="px-4 py-3"><%= formatDateTimeID(item.approved_at) %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
