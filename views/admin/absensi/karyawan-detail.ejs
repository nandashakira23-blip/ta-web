<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/tailwind.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-dark-900 min-h-screen" style="background:#1a1d20;">
    <%
        const formatDateID = (value) => {
            if (!value) return '-';
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return String(value);
            return d.toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' });
        };
        const formatDateTimeID = (value) => {
            if (!value) return '-';
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return String(value);
            return d.toLocaleString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
        };
        const uploadUrl = (value) => {
            if (!value) return null;
            const normalized = String(value).replace(/\\/g, '/').replace(/^public\//, '');
            if (/^https?:\/\//i.test(normalized)) return normalized;
            return '/' + normalized;
        };
        const formatTime = (value) => {
            if (!value) return '-';
            if (value instanceof Date && !Number.isNaN(value.getTime())) {
                return value.toLocaleTimeString('id-ID', {
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: false,
                    timeZone: 'Asia/Makassar'
                });
            }
            const match = String(value).match(/\b(\d{1,2}):(\d{2})(?::\d{2})?\b/);
            if (match) {
                return `${String(match[1]).padStart(2, '0')}:${match[2]}`;
            }
            return String(value).substring(0, 5);
        };
        const formatMinutes = (value) => {
            const minutes = Number(value || 0);
            if (minutes <= 0) return '-';
            const hours = Math.floor(minutes / 60);
            const rest = minutes % 60;
            if (!hours) return `${rest} menit`;
            if (!rest) return `${hours} jam`;
            return `${hours} jam ${rest} menit`;
        };
        const typeLabel = (value) => {
            const normalized = String(value || '').toLowerCase();
            const labels = { cuti: 'Cuti', izin: 'Izin', sakit: 'Sakit' };
            return labels[normalized] || value || '-';
        };
        const categoryLabel = (value) => {
            const normalized = String(value || '').toLowerCase();
            const labels = {
                full_day: 'Seharian',
                half_day: 'Setengah Hari',
                hourly: 'Per Jam'
            };
            return labels[normalized] || value || '-';
        };
        const presensiStatusLabel = (value) => {
            const normalized = String(value || '').toLowerCase();
            const labels = {
                present: 'Hadir',
                late: 'Terlambat',
                on_time: 'Tepat Waktu',
                checked_out: 'Sudah Pulang'
            };
            return labels[normalized] || value || '-';
        };
        const statusMeta = (status) => {
            const normalized = String(status || '').toLowerCase();
            if (['approved', 'disetujui'].includes(normalized)) {
                return { label: 'Disetujui', className: 'bg-green-900/60 text-green-200' };
            }
            if (['rejected', 'ditolak', 'ditolak_pengganti'].includes(normalized)) {
                return { label: normalized === 'ditolak_pengganti' ? 'Ditolak Pengganti' : 'Ditolak', className: 'bg-red-900/60 text-red-200' };
            }
            if (['cancelled', 'dibatalkan'].includes(normalized)) {
                return { label: 'Dibatalkan', className: 'bg-gray-700 text-gray-200' };
            }
            if (normalized === 'menunggu_pengganti') {
                return { label: 'Menunggu Pengganti', className: 'bg-blue-900/60 text-blue-200' };
            }
            return { label: 'Menunggu Manager', className: 'bg-yellow-900/60 text-yellow-200' };
        };
        const canManagerApprove = (status) => ['pending', 'menunggu_manager'].includes(String(status || '').toLowerCase());
        const isManagerRole = admin && admin.role === 'manager';
    %>
    <%- include('../../partials/navbar') %>
    <div class="pt-20">
        <div class="flex flex-col lg:flex-row">
            <%- include('../../partials/sidebar', { currentPage: 'absensi', admin: admin }) %>
            <main class="flex-1 lg:ml-64 p-4 sm:p-6 lg:p-8">
                <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                    <div>
                        <a href="/admin/absensi" class="mb-3 inline-flex items-center gap-2 text-sm text-brown-300 hover:text-white">
                            <i class="fas fa-arrow-left"></i>Kembali ke Manajemen Absensi
                        </a>
                        <h1 class="text-3xl font-bold text-white"><%= employee.nama %></h1>
                        <p class="text-brown-300">NIK <%= employee.nik %> - <%= employee.nama_jabatan || '-' %> - <%= employee.jadwal_kerja || employee.nama_shift || 'Belum ada jadwal' %></p>
                    </div>
                    <span class="w-fit rounded-full px-3 py-1 text-xs <%= employee.is_activated ? 'bg-green-900/60 text-green-200' : 'bg-yellow-900/60 text-yellow-200' %>">
                        <%= employee.is_activated ? 'Aktif' : 'Belum Aktivasi' %>
                    </span>
                </div>

                <% if (messages.success && messages.success.length) { %>
                    <% messages.success.forEach(msg => { %><div class="mb-4 rounded-lg border border-green-700 bg-green-900/60 px-4 py-3 text-green-200"><%= msg %></div><% }) %>
                <% } %>
                <% if (messages.error && messages.error.length) { %>
                    <% messages.error.forEach(msg => { %><div class="mb-4 rounded-lg border border-red-700 bg-red-900/60 px-4 py-3 text-red-200"><%= msg %></div><% }) %>
                <% } %>

                <section class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
                    <div class="rounded-xl border border-brown-700/40 bg-dark-800 p-4">
                        <p class="text-xs uppercase text-brown-300">Total Pengajuan</p>
                        <p class="mt-2 text-2xl font-bold text-white"><%= absensiSummary.total_absensi || 0 %></p>
                    </div>
                    <div class="rounded-xl border border-yellow-700/40 bg-dark-800 p-4">
                        <p class="text-xs uppercase text-yellow-300">Menunggu</p>
                        <p class="mt-2 text-2xl font-bold text-white"><%= absensiSummary.total_pending || 0 %></p>
                    </div>
                    <div class="rounded-xl border border-green-700/40 bg-dark-800 p-4">
                        <p class="text-xs uppercase text-green-300">Disetujui</p>
                        <p class="mt-2 text-2xl font-bold text-white"><%= absensiSummary.total_disetujui || 0 %></p>
                    </div>
                </section>

                <!-- Filter Periode -->
                <% const filterType = (filters && filters.filterType) || 'month'; %>
                <% const today = new Date(); const defaultMonth = today.getMonth() + 1; const defaultYear = today.getFullYear(); %>
                <div class="mb-6 rounded-xl border border-brown-700/40 bg-dark-800 p-4">
                    <form method="GET" action="/admin/absensi/karyawan/<%= employee.id %>" class="space-y-3">
                        <div class="grid grid-cols-1 gap-3 sm:grid-cols-4">
                            <div>
                                <label class="block text-xs text-brown-300 mb-1">Tipe Filter</label>
                                <select name="filterType" onchange="toggleFilterFields(this.value)" id="filterType"
                                    class="w-full rounded-lg border border-brown-700/40 bg-dark-700 px-3 py-2 text-white">
                                    <option value="date" <%= filterType === 'date' ? 'selected' : '' %>>Tanggal</option>
                                    <option value="range" <%= filterType === 'range' ? 'selected' : '' %>>Rentang</option>
                                    <option value="month" <%= filterType === 'month' ? 'selected' : '' %>>Bulan</option>
                                    <option value="year" <%= filterType === 'year' ? 'selected' : '' %>>Tahun</option>
                                </select>
                            </div>
                            <div id="field-date" class="<%= filterType === 'date' ? '' : 'hidden' %>">
                                <label class="block text-xs text-brown-300 mb-1">Tanggal</label>
                                <input type="date" name="tanggal" value="<%= (filters && filters.tanggal) || '' %>"
                                    class="w-full rounded-lg border border-brown-700/40 bg-dark-700 px-3 py-2 text-white">
                            </div>
                            <div id="field-range" class="<%= filterType === 'range' ? 'grid grid-cols-2 gap-2 sm:col-span-2' : 'hidden' %>">
                                <div>
                                    <label class="block text-xs text-brown-300 mb-1">Mulai</label>
                                    <input type="date" name="startDate" value="<%= (filters && filters.startDate) || '' %>"
                                        class="w-full rounded-lg border border-brown-700/40 bg-dark-700 px-3 py-2 text-white">
                                </div>
                                <div>
                                    <label class="block text-xs text-brown-300 mb-1">Akhir</label>
                                    <input type="date" name="endDate" value="<%= (filters && filters.endDate) || '' %>"
                                        class="w-full rounded-lg border border-brown-700/40 bg-dark-700 px-3 py-2 text-white">
                                </div>
                            </div>
                            <div id="field-month" class="<%= filterType === 'month' ? 'grid grid-cols-2 gap-2' : 'hidden' %>">
                                <div>
                                    <label class="block text-xs text-brown-300 mb-1">Bulan</label>
                                    <select name="month" class="w-full rounded-lg border border-brown-700/40 bg-dark-700 px-3 py-2 text-white">
                                        <% const monthNames = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember']; %>
                                        <% monthNames.forEach((m, i) => { %>
                                            <option value="<%= i + 1 %>" <%= ((filters && filters.month) || defaultMonth) == (i + 1) ? 'selected' : '' %>><%= m %></option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs text-brown-300 mb-1">Tahun</label>
                                    <input type="number" name="year" value="<%= (filters && filters.year) || defaultYear %>" min="2020" max="2100"
                                        class="w-full rounded-lg border border-brown-700/40 bg-dark-700 px-3 py-2 text-white">
                                </div>
                            </div>
                            <div id="field-year" class="<%= filterType === 'year' ? '' : 'hidden' %>">
                                <label class="block text-xs text-brown-300 mb-1">Tahun</label>
                                <input type="number" name="year" value="<%= (filters && filters.year) || defaultYear %>" min="2020" max="2100"
                                    class="w-full rounded-lg border border-brown-700/40 bg-dark-700 px-3 py-2 text-white">
                            </div>
                        </div>
                        <div class="flex justify-between items-center">
                            <a href="/admin/presensi/karyawan/<%= employee.id %>" class="text-sm text-blue-400 hover:text-blue-300">
                                <i class="fas fa-calendar-check mr-1"></i>Lihat Riwayat Presensi
                            </a>
                            <div class="flex gap-2">
                                <a href="/admin/absensi/karyawan/<%= employee.id %>" class="rounded-lg border border-brown-700/40 px-4 py-2 text-brown-200 hover:bg-dark-700 text-sm">Reset</a>
                                <button type="submit" class="rounded-lg bg-brown-600 px-4 py-2 text-white hover:bg-brown-500 text-sm">
                                    <i class="fas fa-filter mr-1"></i>Terapkan
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <% const pageInfo = pagination || { page: 1, totalPages: 1, hasPrev: false, hasNext: false, prevPage: 1, nextPage: 1, startItem: 0, endItem: 0, totalItems: 0 }; %>
                <% const qsAbsensi = (() => {
                    const sp = new URLSearchParams();
                    if (filters && filters.filterType) sp.set('filterType', filters.filterType);
                    if (filters && filters.tanggal) sp.set('tanggal', filters.tanggal);
                    if (filters && filters.startDate) sp.set('startDate', filters.startDate);
                    if (filters && filters.endDate) sp.set('endDate', filters.endDate);
                    if (filters && filters.month) sp.set('month', filters.month);
                    if (filters && filters.year) sp.set('year', filters.year);
                    const s = sp.toString();
                    return s ? '&' + s : '';
                })(); %>
                <section class="overflow-hidden rounded-xl border border-brown-700/40 bg-dark-800">
                    <div class="flex flex-col gap-1 border-b border-brown-700/40 bg-dark-700 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
                        <div>
                            <h2 class="font-semibold text-white">Riwayat Absensi</h2>
                            <p class="text-xs text-brown-300">Termasuk pengajuan karyawan dan permintaan saat karyawan ini menjadi pengganti.</p>
                        </div>
                        <div class="text-xs text-brown-300"><%= pageInfo.totalItems %> catatan total</div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-brown-700/40">
                            <thead class="bg-dark-700/60 text-brown-200">
                                <tr>
                                    <th class="px-4 py-3 text-left">Tgl Ajukan</th>
                                    <th class="px-4 py-3 text-left">Relasi</th>
                                    <th class="px-4 py-3 text-left">Jenis / Kategori</th>
                                    <th class="px-4 py-3 text-left">Periode</th>
                                    <th class="px-4 py-3 text-left">Pengganti</th>
                                    <th class="px-4 py-3 text-left">Status</th>
                                    <th class="px-4 py-3 text-left">Approver</th>
                                    <th class="px-4 py-3 text-left">Aksi</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-brown-700/30 text-brown-100">
                                <% if (!absensiRows.length) { %>
                                    <tr><td colspan="8" class="px-4 py-10 text-center text-brown-300">Belum ada riwayat Absensi.</td></tr>
                                <% } %>
                                <% absensiRows.forEach(row => { %>
                                    <% const meta = statusMeta(row.status); %>
                                    <tr class="align-top hover:bg-dark-700/40">
                                        <td class="px-4 py-3 text-sm text-brown-200"><%= formatDateID(row.created_at) %></td>
                                        <td class="px-4 py-3">
                                            <span class="inline-flex items-center rounded-full px-2 py-1 text-xs <%= row.relasi === 'Pengaju' ? 'bg-blue-900/60 text-blue-200' : 'bg-purple-900/60 text-purple-200' %>"><%= row.relasi %></span>
                                        </td>
                                        <td class="px-4 py-3">
                                            <div class="font-medium text-white capitalize"><%= typeLabel(row.jenis) %></div>
                                            <div class="text-xs text-brown-300"><%= categoryLabel(row.kategori) %></div>
                                        </td>
                                        <td class="px-4 py-3">
                                            <div class="text-sm"><%= formatDateID(row.tanggal_mulai) %> s/d <%= formatDateID(row.tanggal_selesai) %></div>
                                            <% if (row.jam_mulai || row.jam_selesai) { %><div class="text-xs text-brown-300"><%= formatTime(row.jam_mulai) %> - <%= formatTime(row.jam_selesai) %></div><% } %>
                                            <div class="text-xs text-brown-400"><%= formatMinutes(row.durasi_menit) %></div>
                                        </td>
                                        <td class="px-4 py-3 text-sm">
                                            <% if (row.nama_pengganti) { %><%= row.nama_pengganti %><% } else { %><span class="text-brown-500">-</span><% } %>
                                            <% if (row.catatan_pengganti) { %><div class="text-xs text-brown-300 mt-1"><%= row.catatan_pengganti %></div><% } %>
                                        </td>
                                        <td class="px-4 py-3">
                                            <span class="rounded-full px-3 py-1 text-xs <%= meta.className %>"><%= meta.label %></span>
                                        </td>
                                        <td class="px-4 py-3">
                                            <% if (row.nama_approver && row.nama_approver !== '-') { %>
                                                <div class="flex items-center gap-2 text-sm">
                                                    <i class="fas fa-user-check text-brown-400 text-xs"></i>
                                                    <span class="text-brown-200"><%= row.nama_approver %></span>
                                                </div>
                                                <% if (row.approved_at) { %>
                                                    <div class="text-xs text-brown-400 mt-1"><%= formatDateID(row.approved_at) %></div>
                                                <% } %>
                                            <% } else { %>
                                                <span class="text-brown-500 text-sm">-</span>
                                            <% } %>
                                        </td>
                                        <td class="px-4 py-3">
                                            <% if (row.alasan) { %><div class="mb-2 text-xs text-brown-300 max-w-xs"><%= row.alasan %></div><% } %>
                                            <% if (row.lampiran) { %>
                                                <a href="<%= uploadUrl(row.lampiran) %>" target="_blank" class="mb-2 inline-flex items-center gap-1 rounded border border-brown-700/40 px-2 py-1 text-xs text-brown-200 hover:text-white hover:bg-dark-700">
                                                    <i class="fas fa-paperclip"></i>Lampiran
                                                </a>
                                            <% } %>
                                            <% if (canManagerApprove(row.status) && isManagerRole) { %>
                                                <div class="flex flex-col gap-2 mt-2">
                                                    <button type="button"
                                                            class="btn-open-approve inline-flex items-center justify-center gap-1 rounded bg-green-700 hover:bg-green-600 px-3 py-2 text-xs text-white font-semibold"
                                                            data-id="<%= row.id %>"
                                                            data-karyawan="<%= row.nama_karyawan || employee.nama %>"
                                                            data-jenis="<%= typeLabel(row.jenis) %> / <%= categoryLabel(row.kategori) %>"
                                                            data-periode="<%= formatDateID(row.tanggal_mulai) %> s/d <%= formatDateID(row.tanggal_selesai) %>">
                                                        <i class="fas fa-check"></i>Setujui
                                                    </button>
                                                    <button type="button"
                                                            class="btn-open-reject inline-flex items-center justify-center gap-1 rounded bg-red-700 hover:bg-red-600 px-3 py-2 text-xs text-white font-semibold"
                                                            data-id="<%= row.id %>"
                                                            data-karyawan="<%= row.nama_karyawan || employee.nama %>"
                                                            data-jenis="<%= typeLabel(row.jenis) %> / <%= categoryLabel(row.kategori) %>"
                                                            data-periode="<%= formatDateID(row.tanggal_mulai) %> s/d <%= formatDateID(row.tanggal_selesai) %>">
                                                        <i class="fas fa-times"></i>Tolak
                                                    </button>
                                                </div>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </section>

                <div class="mt-4 flex flex-col gap-2 text-sm text-brown-300 sm:flex-row sm:items-center sm:justify-between">
                    <div>Menampilkan <%= pageInfo.startItem %>-<%= pageInfo.endItem %> dari <%= pageInfo.totalItems %> data</div>
                    <div class="flex items-center gap-2">
                        <a href="/admin/absensi/karyawan/<%= employee.id %>?page=<%= pageInfo.prevPage %><%= qsAbsensi %>" class="rounded border border-brown-700/40 px-3 py-1 <%= pageInfo.hasPrev ? 'text-brown-200 hover:bg-dark-700' : 'pointer-events-none opacity-40 text-brown-500' %>">Prev</a>
                        <span class="text-brown-200">Hal <%= pageInfo.page %>/<%= pageInfo.totalPages %></span>
                        <a href="/admin/absensi/karyawan/<%= employee.id %>?page=<%= pageInfo.nextPage %><%= qsAbsensi %>" class="rounded border border-brown-700/40 px-3 py-1 <%= pageInfo.hasNext ? 'text-brown-200 hover:bg-dark-700' : 'pointer-events-none opacity-40 text-brown-500' %>">Next</a>
                    </div>
                </div>
            </main>
        </div>
    </div>
    <!-- Modal Setujui Pengajuan -->
    <div id="approveModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 backdrop-blur-sm p-4">
        <div class="w-full max-w-md rounded-2xl border border-green-700/40 bg-dark-800 shadow-2xl overflow-hidden">
            <form id="approveForm" method="POST">
                <div class="flex items-center justify-between border-b border-brown-600/30 px-5 py-4 bg-green-900/30">
                    <h3 class="text-lg font-bold text-white"><i class="fas fa-check-circle mr-2 text-green-400"></i>Setujui Pengajuan</h3>
                    <button type="button" class="btn-close-modal text-brown-400 hover:text-white p-1 rounded" data-target="approveModal">
                        <i class="fas fa-times text-lg"></i>
                    </button>
                </div>
                <div class="p-5 space-y-3">
                    <div class="rounded-lg border border-brown-700/40 bg-dark-700/40 p-3 space-y-1">
                        <div class="text-sm"><span class="text-brown-400">Karyawan:</span> <span id="approveKaryawan" class="font-semibold text-white"></span></div>
                        <div class="text-sm"><span class="text-brown-400">Jenis:</span> <span id="approveJenis" class="text-brown-200"></span></div>
                        <div class="text-sm"><span class="text-brown-400">Periode:</span> <span id="approvePeriode" class="text-brown-200"></span></div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-brown-300 mb-1">Catatan Persetujuan (opsional)</label>
                        <textarea name="approval_notes" rows="3"
                                  class="w-full rounded-lg border border-brown-700/40 bg-dark-700 px-3 py-2 text-white placeholder-brown-400 focus:ring-2 focus:ring-green-500"
                                  placeholder="Contoh: Disetujui sesuai prosedur, atau alasan lain..."></textarea>
                    </div>
                </div>
                <div class="flex justify-end gap-2 border-t border-brown-600/30 px-5 py-3">
                    <button type="button" class="btn-close-modal rounded-lg border border-brown-700/40 px-4 py-2 text-brown-200 hover:bg-dark-700 text-sm" data-target="approveModal">Batal</button>
                    <button type="submit" class="rounded-lg bg-green-700 hover:bg-green-600 text-white px-5 py-2 text-sm font-semibold"><i class="fas fa-check mr-1"></i>Konfirmasi Setujui</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Tolak Pengajuan -->
    <div id="rejectModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 backdrop-blur-sm p-4">
        <div class="w-full max-w-md rounded-2xl border border-red-700/40 bg-dark-800 shadow-2xl overflow-hidden">
            <form id="rejectForm" method="POST">
                <div class="flex items-center justify-between border-b border-brown-600/30 px-5 py-4 bg-red-900/30">
                    <h3 class="text-lg font-bold text-white"><i class="fas fa-times-circle mr-2 text-red-400"></i>Tolak Pengajuan</h3>
                    <button type="button" class="btn-close-modal text-brown-400 hover:text-white p-1 rounded" data-target="rejectModal">
                        <i class="fas fa-times text-lg"></i>
                    </button>
                </div>
                <div class="p-5 space-y-3">
                    <div class="rounded-lg border border-brown-700/40 bg-dark-700/40 p-3 space-y-1">
                        <div class="text-sm"><span class="text-brown-400">Karyawan:</span> <span id="rejectKaryawan" class="font-semibold text-white"></span></div>
                        <div class="text-sm"><span class="text-brown-400">Jenis:</span> <span id="rejectJenis" class="text-brown-200"></span></div>
                        <div class="text-sm"><span class="text-brown-400">Periode:</span> <span id="rejectPeriode" class="text-brown-200"></span></div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-brown-300 mb-1">Alasan Penolakan <span class="text-red-400">*</span></label>
                        <textarea name="rejection_reason" rows="3" required
                                  class="w-full rounded-lg border border-brown-700/40 bg-dark-700 px-3 py-2 text-white placeholder-brown-400 focus:ring-2 focus:ring-red-500"
                                  placeholder="Tuliskan alasan penolakan yang akan dikomunikasikan kepada karyawan..."></textarea>
                        <p class="text-xs text-brown-400 mt-1">Alasan wajib diisi sebagai bahan komunikasi kepada karyawan.</p>
                    </div>
                </div>
                <div class="flex justify-end gap-2 border-t border-brown-600/30 px-5 py-3">
                    <button type="button" class="btn-close-modal rounded-lg border border-brown-700/40 px-4 py-2 text-brown-200 hover:bg-dark-700 text-sm" data-target="rejectModal">Batal</button>
                    <button type="submit" class="rounded-lg bg-red-700 hover:bg-red-600 text-white px-5 py-2 text-sm font-semibold"><i class="fas fa-times mr-1"></i>Konfirmasi Tolak</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Approve/Reject modal handlers
        (function () {
            const approveModal = document.getElementById('approveModal');
            const rejectModal = document.getElementById('rejectModal');
            const approveForm = document.getElementById('approveForm');
            const rejectForm = document.getElementById('rejectForm');

            function openModal(modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                const ta = modal.querySelector('textarea');
                if (ta) setTimeout(() => ta.focus(), 50);
            }
            function closeModal(modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                const ta = modal.querySelector('textarea');
                if (ta) ta.value = '';
            }

            document.querySelectorAll('.btn-open-approve').forEach(btn => {
                btn.addEventListener('click', () => {
                    approveForm.action = '/admin/absensi/' + btn.dataset.id + '/approve';
                    document.getElementById('approveKaryawan').textContent = btn.dataset.karyawan;
                    document.getElementById('approveJenis').textContent = btn.dataset.jenis;
                    document.getElementById('approvePeriode').textContent = btn.dataset.periode;
                    openModal(approveModal);
                });
            });

            document.querySelectorAll('.btn-open-reject').forEach(btn => {
                btn.addEventListener('click', () => {
                    rejectForm.action = '/admin/absensi/' + btn.dataset.id + '/reject';
                    document.getElementById('rejectKaryawan').textContent = btn.dataset.karyawan;
                    document.getElementById('rejectJenis').textContent = btn.dataset.jenis;
                    document.getElementById('rejectPeriode').textContent = btn.dataset.periode;
                    openModal(rejectModal);
                });
            });

            document.querySelectorAll('.btn-close-modal').forEach(btn => {
                btn.addEventListener('click', () => {
                    const target = document.getElementById(btn.dataset.target);
                    if (target) closeModal(target);
                });
            });
            approveModal.addEventListener('click', e => { if (e.target === approveModal) closeModal(approveModal); });
            rejectModal.addEventListener('click', e => { if (e.target === rejectModal) closeModal(rejectModal); });
            document.addEventListener('keydown', e => {
                if (e.key === 'Escape') {
                    if (!approveModal.classList.contains('hidden')) closeModal(approveModal);
                    if (!rejectModal.classList.contains('hidden')) closeModal(rejectModal);
                }
            });
        })();

        function toggleFilterFields(type) {
            ['date', 'range', 'month', 'year'].forEach(t => {
                const el = document.getElementById('field-' + t);
                if (el) el.classList.add('hidden');
            });
            const active = document.getElementById('field-' + type);
            if (active) active.classList.remove('hidden');
        }
    </script>
</body>
</html>
