<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/tailwind.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .solid-background { background: #1a1d20; }
        .tab-button {
            color: #d4bfa6;
            background: transparent;
            border-bottom: 3px solid transparent;
        }
        .tab-button:hover {
            color: #b8956b;
            background: rgba(166, 124, 82, 0.1);
        }
        .tab-button.active {
            color: #ffffff;
            background: rgba(166, 124, 82, 0.2);
            border-bottom-color: #a67c52;
        }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
    </style>
</head>
<body class="bg-dark-900 min-h-screen solid-background">
    <%- include('../partials/navbar') %>

    <div class="pt-16 sm:pt-20 lg:pt-20">
        <div class="lg:hidden pt-16 sm:pt-20"></div>

        <div class="flex flex-col lg:flex-row">
            <%- include('../partials/sidebar', { currentPage: 'laporan' }) %>

            <div class="flex-1 lg:ml-64 p-4 sm:p-6 lg:p-8 min-h-screen">
                <!-- Page Header -->
                <div class="mb-6 sm:mb-8">
                    <div class="flex items-center space-x-3 mb-2">
                        <div class="w-8 h-8 flex items-center justify-center">
                            <i class="fas fa-chart-line text-brown-400 text-xl"></i>
                        </div>
                        <h2 class="text-2xl sm:text-3xl font-bold text-white">Laporan</h2>
                    </div>
                    <p class="text-brown-300 text-sm sm:text-base">Rekap dan ekspor laporan presensi serta absensi karyawan FLEUR CAFÉ - Atelier d'artistes</p>
                </div>

                <!-- Filter -->
                <div class="bg-dark-800 rounded-xl shadow-2xl p-4 sm:p-6 mb-6 border border-brown-600/30">
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="text-lg font-bold text-white flex items-center">
                            <i class="fas fa-filter text-brown-400 mr-3"></i>
                            Filter Periode
                        </h3>
                    </div>

                    <form method="GET" action="/admin/laporan" id="filterForm">
                        <div class="mb-4">
                            <label class="block text-sm font-medium text-brown-300 mb-2">Tipe Filter</label>
                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                                <button type="button" onclick="setFilterType('date', this)"
                                    class="filter-type-btn px-4 py-2 rounded-lg border transition duration-200 <%= filter.filterType === 'date' || !filter.filterType ? 'bg-brown-600 border-brown-500 text-white' : 'bg-dark-700 border-brown-600/50 text-brown-300 hover:bg-dark-600' %>">
                                    <i class="fas fa-calendar-day mr-2"></i>Tanggal
                                </button>
                                <button type="button" onclick="setFilterType('range', this)"
                                    class="filter-type-btn px-4 py-2 rounded-lg border transition duration-200 <%= filter.filterType === 'range' ? 'bg-brown-600 border-brown-500 text-white' : 'bg-dark-700 border-brown-600/50 text-brown-300 hover:bg-dark-600' %>">
                                    <i class="fas fa-calendar-week mr-2"></i>Rentang
                                </button>
                                <button type="button" onclick="setFilterType('month', this)"
                                    class="filter-type-btn px-4 py-2 rounded-lg border transition duration-200 <%= filter.filterType === 'month' ? 'bg-brown-600 border-brown-500 text-white' : 'bg-dark-700 border-brown-600/50 text-brown-300 hover:bg-dark-600' %>">
                                    <i class="fas fa-calendar-alt mr-2"></i>Bulan
                                </button>
                                <button type="button" onclick="setFilterType('year', this)"
                                    class="filter-type-btn px-4 py-2 rounded-lg border transition duration-200 <%= filter.filterType === 'year' ? 'bg-brown-600 border-brown-500 text-white' : 'bg-dark-700 border-brown-600/50 text-brown-300 hover:bg-dark-600' %>">
                                    <i class="fas fa-calendar mr-2"></i>Tahun
                                </button>
                            </div>
                        </div>

                        <input type="hidden" name="filterType" id="filterType" value="<%= filter.filterType || 'date' %>">

                        <div id="dateFilter" class="filter-content <%= filter.filterType === 'date' || !filter.filterType ? '' : 'hidden' %>">
                            <label for="tanggal" class="block text-sm font-medium text-brown-300 mb-2">Pilih Tanggal</label>
                            <input type="date" id="tanggal" name="tanggal" value="<%= filter.tanggal %>"
                                class="w-full px-4 py-2 bg-dark-700 border border-brown-600/50 rounded-lg focus:ring-2 focus:ring-brown-500 focus:border-brown-400 text-white">
                        </div>

                        <div id="rangeFilter" class="filter-content <%= filter.filterType === 'range' ? '' : 'hidden' %>">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label for="startDate" class="block text-sm font-medium text-brown-300 mb-2">Tanggal Mulai</label>
                                    <input type="date" id="startDate" name="startDate" value="<%= filter.startDate || '' %>"
                                        class="w-full px-4 py-2 bg-dark-700 border border-brown-600/50 rounded-lg focus:ring-2 focus:ring-brown-500 focus:border-brown-400 text-white">
                                </div>
                                <div>
                                    <label for="endDate" class="block text-sm font-medium text-brown-300 mb-2">Tanggal Akhir</label>
                                    <input type="date" id="endDate" name="endDate" value="<%= filter.endDate || '' %>"
                                        class="w-full px-4 py-2 bg-dark-700 border border-brown-600/50 rounded-lg focus:ring-2 focus:ring-brown-500 focus:border-brown-400 text-white">
                                </div>
                            </div>
                        </div>

                        <div id="monthFilter" class="filter-content <%= filter.filterType === 'month' ? '' : 'hidden' %>">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label for="month" class="block text-sm font-medium text-brown-300 mb-2">Bulan</label>
                                    <select id="month" name="month" class="w-full px-4 py-2 bg-dark-700 border border-brown-600/50 rounded-lg focus:ring-2 focus:ring-brown-500 focus:border-brown-400 text-white">
                                        <option value="">Pilih Bulan</option>
                                        <% const months = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
                                           months.forEach((m, i) => { %>
                                            <option value="<%= i + 1 %>" <%= filter.month == (i + 1) ? 'selected' : '' %>><%= m %></option>
                                        <% }); %>
                                    </select>
                                </div>
                                <div>
                                    <label for="yearMonth" class="block text-sm font-medium text-brown-300 mb-2">Tahun</label>
                                    <input type="number" id="yearMonth" name="year" value="<%= filter.year || new Date().getFullYear() %>" min="2020" max="2100"
                                        class="w-full px-4 py-2 bg-dark-700 border border-brown-600/50 rounded-lg focus:ring-2 focus:ring-brown-500 focus:border-brown-400 text-white">
                                </div>
                            </div>
                        </div>

                        <div id="yearFilter" class="filter-content <%= filter.filterType === 'year' ? '' : 'hidden' %>">
                            <label for="yearOnly" class="block text-sm font-medium text-brown-300 mb-2">Pilih Tahun</label>
                            <input type="number" id="yearOnly" name="year" value="<%= filter.year || new Date().getFullYear() %>" min="2020" max="2100"
                                class="w-full px-4 py-2 bg-dark-700 border border-brown-600/50 rounded-lg focus:ring-2 focus:ring-brown-500 focus:border-brown-400 text-white">
                        </div>

                        <div class="flex space-x-2 mt-4">
                            <button type="submit" class="bg-brown-600 hover:bg-brown-500 text-white px-6 py-2 rounded-lg transition duration-200 text-sm shadow-lg flex-1">
                                <i class="fas fa-search mr-2"></i>Tampilkan
                            </button>
                            <a href="/admin/laporan" class="bg-gray-600 hover:bg-gray-500 text-white px-6 py-2 rounded-lg transition duration-200 text-sm shadow-lg text-center">
                                <i class="fas fa-refresh mr-2"></i>Reset
                            </a>
                        </div>
                    </form>
                </div>

                <%
                    const pInfo = paginationPresensi || { page: 1, totalPages: 1, hasPrev: false, hasNext: false, prevPage: 1, nextPage: 1, startItem: 0, endItem: 0, totalItems: 0 };
                    const aInfo = paginationAbsensi || { page: 1, totalPages: 1, hasPrev: false, hasNext: false, prevPage: 1, nextPage: 1, startItem: 0, endItem: 0, totalItems: 0 };
                    const filterQS = (() => {
                        const sp = new URLSearchParams();
                        if (filter && filter.filterType) sp.set('filterType', filter.filterType);
                        if (filter && filter.tanggal) sp.set('tanggal', filter.tanggal);
                        if (filter && filter.startDate) sp.set('startDate', filter.startDate);
                        if (filter && filter.endDate) sp.set('endDate', filter.endDate);
                        if (filter && filter.month) sp.set('month', filter.month);
                        if (filter && filter.year) sp.set('year', filter.year);
                        return sp.toString();
                    })();
                %>

                <!-- Tab Navigation -->
                <div class="bg-dark-800 rounded-xl shadow-2xl mb-6 border border-brown-600/30">
                    <div class="flex border-b border-brown-600/30">
                        <button id="tabPresensi" class="tab-button active flex-1 px-6 py-4 text-center font-medium transition duration-200 rounded-tl-xl">
                            <i class="fas fa-clipboard-check mr-2"></i>
                            Laporan Presensi
                            <span class="ml-2 inline-flex px-2 py-0.5 text-xs rounded-full bg-brown-700/50 text-brown-200"><%= pInfo.totalItems %></span>
                        </button>
                        <button id="tabAbsensi" class="tab-button flex-1 px-6 py-4 text-center font-medium transition duration-200 rounded-tr-xl">
                            <i class="fas fa-file-medical mr-2"></i>
                            Laporan Absensi
                            <span class="ml-2 inline-flex px-2 py-0.5 text-xs rounded-full bg-brown-700/50 text-brown-200"><%= aInfo.totalItems %></span>
                        </button>
                    </div>
                </div>

                <!-- TAB 1: Laporan Presensi -->
                <div id="contentPresensi" class="tab-content active">
                    <div class="bg-dark-800 rounded-xl shadow-2xl overflow-hidden border border-brown-600/30">
                        <div class="flex justify-between items-center p-4 border-b border-brown-600/30">
                            <h3 class="text-lg font-bold text-white"><i class="fas fa-clipboard-check text-brown-400 mr-2"></i>Rekap Presensi Karyawan</h3>
                            <% if (!(admin && admin.role === 'manager')) { %>
                            <button id="btnExportPresensi" class="bg-green-600 hover:bg-green-500 text-white px-4 py-2 rounded-lg text-sm shadow-lg">
                                <i class="fas fa-file-excel mr-2"></i>Export Excel
                            </button>
                            <% } %>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="min-w-full divide-y divide-brown-600/30">
                                <thead class="bg-brown-800">
                                    <tr>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-brown-200 uppercase tracking-wider">Nama</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-brown-200 uppercase tracking-wider">Jabatan</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-brown-200 uppercase tracking-wider">Tanggal</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-brown-200 uppercase tracking-wider">Jam Masuk</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-brown-200 uppercase tracking-wider">Jam Keluar</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-brown-200 uppercase tracking-wider">Status</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-brown-600/30">
                                    <% if (presensi.length === 0) { %>
                                        <tr><td colspan="6" class="px-6 py-8 text-center text-brown-300">
                                            <i class="fas fa-inbox text-4xl mb-4 text-brown-400 block"></i>
                                            Tidak ada data presensi untuk periode yang dipilih
                                        </td></tr>
                                    <% } else { %>
                                        <% presensi.forEach(p => { %>
                                            <tr class="hover:bg-dark-600/50">
                                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-white"><%= p.nama %></td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-brown-200"><%= p.jabatan || '-' %></td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-brown-200"><%= new Date(p.tanggal).toLocaleDateString('id-ID') %></td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-brown-200"><%= p.jam_masuk || '-' %></td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-brown-200"><%= p.jam_keluar || '-' %></td>
                                                <td class="px-6 py-4 whitespace-nowrap">
                                                    <% if (['hadir','present','late'].includes(String(p.status || '').toLowerCase())) { %>
                                                        <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-green-900/50 text-green-300 border border-green-600/50">
                                                            <i class="fas fa-check-circle mr-1"></i>Hadir
                                                        </span>
                                                    <% } else { %>
                                                        <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-red-900/50 text-red-300 border border-red-600/50">
                                                            <i class="fas fa-exclamation-triangle mr-1"></i><%= p.status %>
                                                        </span>
                                                    <% } %>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                        <div class="flex flex-col gap-2 border-t border-brown-600/30 px-4 py-3 text-sm text-brown-300 sm:flex-row sm:items-center sm:justify-between">
                            <div>Menampilkan <%= pInfo.startItem %>-<%= pInfo.endItem %> dari <%= pInfo.totalItems %> data</div>
                            <div class="flex items-center gap-2">
                                <a href="/admin/laporan?pp=<%= pInfo.prevPage %>&ap=<%= aInfo.page %><%= filterQS ? '&' + filterQS : '' %>" class="rounded border border-brown-700/40 px-3 py-1 <%= pInfo.hasPrev ? 'text-brown-200 hover:bg-dark-700' : 'pointer-events-none opacity-40 text-brown-500' %>">Prev</a>
                                <span class="text-brown-200">Hal <%= pInfo.page %>/<%= pInfo.totalPages %></span>
                                <a href="/admin/laporan?pp=<%= pInfo.nextPage %>&ap=<%= aInfo.page %><%= filterQS ? '&' + filterQS : '' %>" class="rounded border border-brown-700/40 px-3 py-1 <%= pInfo.hasNext ? 'text-brown-200 hover:bg-dark-700' : 'pointer-events-none opacity-40 text-brown-500' %>">Next</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TAB 2: Laporan Absensi -->
                <div id="contentAbsensi" class="tab-content">
                    <div class="bg-dark-800 rounded-xl shadow-2xl overflow-hidden border border-brown-600/30">
                        <div class="flex justify-between items-center p-4 border-b border-brown-600/30">
                            <h3 class="text-lg font-bold text-white"><i class="fas fa-file-medical text-brown-400 mr-2"></i>Rekap Pengajuan Cuti/Izin/Sakit</h3>
                            <% if (!(admin && admin.role === 'manager')) { %>
                            <button id="btnExportAbsensi" class="bg-green-600 hover:bg-green-500 text-white px-4 py-2 rounded-lg text-sm shadow-lg">
                                <i class="fas fa-file-excel mr-2"></i>Export Excel
                            </button>
                            <% } %>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="min-w-full divide-y divide-brown-600/30">
                                <thead class="bg-brown-800">
                                    <tr>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-brown-200 uppercase tracking-wider">Tgl Ajukan</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-brown-200 uppercase tracking-wider">Karyawan</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-brown-200 uppercase tracking-wider">Jenis / Kategori</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-brown-200 uppercase tracking-wider">Periode</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-brown-200 uppercase tracking-wider">Status</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-brown-200 uppercase tracking-wider">Approver</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-brown-600/30">
                                    <% if (absensi.length === 0) { %>
                                        <tr><td colspan="6" class="px-6 py-8 text-center text-brown-300">
                                            <i class="fas fa-inbox text-4xl mb-4 text-brown-400 block"></i>
                                            Tidak ada pengajuan absensi untuk periode yang dipilih
                                        </td></tr>
                                    <% } else { %>
                                        <% absensi.forEach(a => { %>
                                            <tr class="hover:bg-dark-600/50">
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-brown-200"><%= new Date(a.created_at).toLocaleDateString('id-ID') %></td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                                    <div class="font-medium text-white"><%= a.nama_karyawan %></div>
                                                    <div class="text-xs text-brown-400"><%= a.nik %></div>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                                    <div class="font-semibold text-brown-200 capitalize"><%= a.jenis %></div>
                                                    <div class="text-xs text-brown-400 capitalize"><%= a.kategori || '-' %></div>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-brown-200">
                                                    <%= new Date(a.tanggal_mulai).toLocaleDateString('id-ID') %>
                                                    <% if (a.tanggal_selesai && a.tanggal_selesai !== a.tanggal_mulai) { %>
                                                        – <%= new Date(a.tanggal_selesai).toLocaleDateString('id-ID') %>
                                                    <% } %>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap">
                                                    <% const st = String(a.status || '').toLowerCase(); %>
                                                    <% if (['approved','disetujui'].includes(st)) { %>
                                                        <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-green-900/50 text-green-300 border border-green-600/50"><i class="fas fa-check-circle mr-1"></i>Disetujui</span>
                                                    <% } else if (['rejected','ditolak','ditolak_pengganti'].includes(st)) { %>
                                                        <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-red-900/50 text-red-300 border border-red-600/50"><i class="fas fa-times-circle mr-1"></i>Ditolak</span>
                                                    <% } else { %>
                                                        <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-yellow-900/50 text-yellow-300 border border-yellow-600/50"><i class="fas fa-clock mr-1"></i><%= a.status %></span>
                                                    <% } %>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-brown-200"><%= a.nama_approver || '-' %></td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                        <div class="flex flex-col gap-2 border-t border-brown-600/30 px-4 py-3 text-sm text-brown-300 sm:flex-row sm:items-center sm:justify-between">
                            <div>Menampilkan <%= aInfo.startItem %>-<%= aInfo.endItem %> dari <%= aInfo.totalItems %> data</div>
                            <div class="flex items-center gap-2">
                                <a href="/admin/laporan?pp=<%= pInfo.page %>&ap=<%= aInfo.prevPage %><%= filterQS ? '&' + filterQS : '' %>" class="rounded border border-brown-700/40 px-3 py-1 <%= aInfo.hasPrev ? 'text-brown-200 hover:bg-dark-700' : 'pointer-events-none opacity-40 text-brown-500' %>">Prev</a>
                                <span class="text-brown-200">Hal <%= aInfo.page %>/<%= aInfo.totalPages %></span>
                                <a href="/admin/laporan?pp=<%= pInfo.page %>&ap=<%= aInfo.nextPage %><%= filterQS ? '&' + filterQS : '' %>" class="rounded border border-brown-700/40 px-3 py-1 <%= aInfo.hasNext ? 'text-brown-200 hover:bg-dark-700' : 'pointer-events-none opacity-40 text-brown-500' %>">Next</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function switchTab(tabName) {
            document.querySelectorAll('.tab-button').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
            document.getElementById('tab' + tabName).classList.add('active');
            document.getElementById('content' + tabName).classList.add('active');
            try { localStorage.setItem('laporan_active_tab', tabName); } catch (e) {}
        }

        function setFilterType(type, btn) {
            document.querySelectorAll('.filter-type-btn').forEach(b => {
                b.classList.remove('bg-brown-600', 'border-brown-500', 'text-white');
                b.classList.add('bg-dark-700', 'border-brown-600/50', 'text-brown-300');
            });
            btn.classList.remove('bg-dark-700', 'border-brown-600/50', 'text-brown-300');
            btn.classList.add('bg-brown-600', 'border-brown-500', 'text-white');
            document.getElementById('filterType').value = type;
            document.querySelectorAll('.filter-content').forEach(c => c.classList.add('hidden'));
            const el = document.getElementById(type + 'Filter');
            if (el) el.classList.remove('hidden');
        }

        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('tabPresensi').addEventListener('click', () => switchTab('Presensi'));
            document.getElementById('tabAbsensi').addEventListener('click', () => switchTab('Absensi'));
            try {
                const saved = localStorage.getItem('laporan_active_tab');
                if (saved) switchTab(saved);
            } catch (e) {}

            const btnExportPresensi = document.getElementById('btnExportPresensi');
            if (btnExportPresensi) {
                btnExportPresensi.addEventListener('click', function () {
                    const params = new URLSearchParams(new FormData(document.getElementById('filterForm'))).toString();
                    window.location.href = '/admin/laporan/export?' + params;
                });
            }
            const btnExportAbsensi = document.getElementById('btnExportAbsensi');
            if (btnExportAbsensi) {
                btnExportAbsensi.addEventListener('click', function () {
                    const params = new URLSearchParams(new FormData(document.getElementById('filterForm'))).toString();
                    window.location.href = '/admin/laporan/export-absensi?' + params;
                });
            }
        });
    </script>
</body>
</html>
