<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/tailwind.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-dark-900 min-h-screen" style="background:#1a1d20;">
    <%
        const formatDateID = (value) => {
            if (!value) return '-';
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return String(value);
            return d.toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' });
        };
        const uploadUrl = (value) => {
            if (!value) return null;
            const normalized = String(value).replace(/\\/g, '/').replace(/^public\//, '');
            if (/^https?:\/\//i.test(normalized)) return normalized;
            return '/' + normalized;
        };
        const q = (filters && filters.q) ? filters.q : '';
        const employeeList = employees || [];
        const pageInfo = pagination || { page: 1, totalPages: 1, hasPrev: false, hasNext: false, prevPage: 1, nextPage: 1, startItem: 0, endItem: 0, totalItems: 0 };
        const queryQ = q ? `&q=${encodeURIComponent(q)}` : '';
        const typeLabel = (value) => {
            const normalized = String(value || '').toLowerCase();
            const labels = { cuti: 'Cuti', izin: 'Izin', sakit: 'Sakit' };
            return labels[normalized] || value || '-';
        };
        const categoryLabel = (value) => {
            const normalized = String(value || '').toLowerCase();
            const labels = {
                full_day: 'Seharian',
                half_day: 'Setengah Hari',
                hourly: 'Per Jam'
            };
            return labels[normalized] || value || '-';
        };
        const statusMeta = (status) => {
            const normalized = String(status || '').toLowerCase();
            if (['approved', 'disetujui'].includes(normalized)) {
                return { label: 'Disetujui', className: 'bg-green-900/60 text-green-200' };
            }
            if (['rejected', 'ditolak', 'ditolak_pengganti'].includes(normalized)) {
                return { label: normalized === 'ditolak_pengganti' ? 'Ditolak Pengganti' : 'Ditolak', className: 'bg-red-900/60 text-red-200' };
            }
            if (['cancelled', 'dibatalkan'].includes(normalized)) {
                return { label: 'Dibatalkan', className: 'bg-gray-700 text-gray-200' };
            }
            if (normalized === 'menunggu_pengganti') {
                return { label: 'Menunggu Pengganti', className: 'bg-blue-900/60 text-blue-200' };
            }
            return { label: 'Menunggu Manager', className: 'bg-yellow-900/60 text-yellow-200' };
        };
        const canManagerApprove = (status) => ['pending', 'menunggu_manager'].includes(String(status || '').toLowerCase());
        const isManagerRole = admin && admin.role === 'manager';
    %>
    <%- include('../../partials/navbar') %>
    <div class="pt-20">
        <div class="flex flex-col lg:flex-row">
            <%- include('../../partials/sidebar', { currentPage: 'absensi', admin: admin }) %>
            <div class="flex-1 lg:ml-64 p-4 sm:p-6 lg:p-8">
                <div class="mb-6 flex items-start justify-between gap-3">
                    <div>
                        <h1 class="text-3xl font-bold text-white">Manajemen Absensi</h1>
                        <p class="text-brown-300">Pusat data karyawan, presensi, pengajuan cuti/izin/sakit, pengganti, dan persetujuan manager.</p>
                    </div>
                    <button type="button" onclick="window.location.href='/admin/absensi/export' + window.location.search"
                            class="shrink-0 bg-green-600 hover:bg-green-500 text-white px-4 py-2 rounded-lg transition duration-200 text-sm shadow-lg">
                        <i class="fas fa-file-excel mr-2"></i>Export Excel
                    </button>
                </div>

                <% if (messages.success && messages.success.length) { %>
                    <% messages.success.forEach(msg => { %><div class="mb-4 rounded-lg border border-green-700 bg-green-900/60 px-4 py-3 text-green-200"><%= msg %></div><% }) %>
                <% } %>
                <% if (messages.error && messages.error.length) { %>
                    <% messages.error.forEach(msg => { %><div class="mb-4 rounded-lg border border-red-700 bg-red-900/60 px-4 py-3 text-red-200"><%= msg %></div><% }) %>
                <% } %>

                <form method="GET" action="/admin/absensi" class="mb-4 flex flex-col gap-2 sm:flex-row">
                    <input
                        type="text"
                        name="q"
                        value="<%= q %>"
                        placeholder="Cari nama/NIK/jenis/alasan/status..."
                        class="w-full rounded-lg border border-brown-700/40 bg-dark-700 px-3 py-2 text-white sm:max-w-sm" />
                    <button type="submit" class="rounded-lg bg-brown-600 px-4 py-2 text-white hover:bg-brown-500">Cari</button>
                    <% if (q) { %>
                        <a href="/admin/absensi" class="rounded-lg border border-brown-700/40 px-4 py-2 text-brown-200 hover:bg-dark-700">Reset</a>
                    <% } %>
                </form>

                <div class="mb-6 overflow-hidden rounded-xl border border-brown-700/40 bg-dark-800">
                    <div class="flex flex-col gap-2 border-b border-brown-700/40 bg-dark-700 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
                        <div>
                            <div class="font-semibold text-white">Data Karyawan</div>
                            <div class="text-xs text-brown-300">Klik detail untuk melihat seluruh data presensi dan Absensi karyawan.</div>
                        </div>
                        <div class="text-xs text-brown-300"><%= employeeList.length %> karyawan ditampilkan</div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-brown-700/40">
                            <thead class="bg-dark-700/60 text-brown-200">
                                <tr>
                                    <th class="px-4 py-3 text-left">Karyawan</th>
                                    <th class="px-4 py-3 text-left">Jabatan / Jadwal</th>
                                    <th class="px-4 py-3 text-left">Presensi</th>
                                    <th class="px-4 py-3 text-left">Absensi</th>
                                    <th class="px-4 py-3 text-left">Status</th>
                                    <th class="px-4 py-3 text-left">Aksi</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-brown-700/30 text-brown-100">
                                <% if (employeeList.length === 0) { %>
                                    <tr><td colspan="6" class="px-4 py-10 text-center text-brown-300">Tidak ada karyawan yang cocok.</td></tr>
                                <% } %>
                                <% employeeList.forEach(k => { %>
                                    <tr class="hover:bg-dark-700/40">
                                        <td class="px-4 py-3">
                                            <div class="font-semibold text-white"><%= k.nama %></div>
                                            <div class="text-xs text-brown-300">NIK <%= k.nik %></div>
                                            <% if (k.email) { %><div class="text-xs text-brown-400"><%= k.email %></div><% } %>
                                        </td>
                                        <td class="px-4 py-3">
                                            <div><%= k.nama_jabatan || '-' %></div>
                                            <div class="text-xs text-brown-300"><%= k.jadwal_kerja || k.nama_shift || 'Belum ada jadwal' %></div>
                                        </td>
                                        <td class="px-4 py-3">
                                            <div><span class="font-semibold text-white"><%= k.total_presensi || 0 %></span> catatan</div>
                                            <div class="text-xs text-brown-300">Hari ini: <%= k.presensi_hari_ini || 0 %>, terlambat: <%= k.total_terlambat || 0 %></div>
                                        </td>
                                        <td class="px-4 py-3">
                                            <div><span class="font-semibold text-white"><%= k.total_absensi || 0 %></span> pengajuan</div>
                                            <div class="text-xs <%= (k.absensi_pending || 0) > 0 ? 'text-yellow-200' : 'text-brown-300' %>">Menunggu: <%= k.absensi_pending || 0 %></div>
                                        </td>
                                        <td class="px-4 py-3">
                                            <span class="rounded-full px-3 py-1 text-xs <%= k.is_activated ? 'bg-green-900/60 text-green-200' : 'bg-yellow-900/60 text-yellow-200' %>"><%= k.is_activated ? 'Aktif' : 'Belum Aktivasi' %></span>
                                        </td>
                                        <td class="px-4 py-3">
                                            <a href="/admin/absensi/karyawan/<%= k.id %>" class="inline-flex items-center gap-2 rounded bg-brown-600 px-3 py-2 text-sm text-white hover:bg-brown-500">
                                                <i class="fas fa-eye"></i>Detail
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mb-3">
                    <h2 class="text-xl font-semibold text-white">Pengajuan & Persetujuan Absensi</h2>
                    <p class="text-sm text-brown-300">Pengajuan yang menunggu manager dapat langsung disetujui atau ditolak di daftar ini.</p>
                </div>

                <div class="overflow-hidden rounded-xl border border-brown-700/40 bg-dark-800">
                    <table class="min-w-full divide-y divide-brown-700/40">
                        <thead class="bg-dark-700 text-brown-200">
                            <tr>
                                <th class="px-4 py-3 text-left">Karyawan</th>
                                <th class="px-4 py-3 text-left">Jenis</th>
                                <th class="px-4 py-3 text-left">Periode</th>
                                <th class="px-4 py-3 text-left">Durasi</th>
                                <th class="px-4 py-3 text-left">Pengganti</th>
                                <th class="px-4 py-3 text-left">Status</th>
                                <th class="px-4 py-3 text-left">Aksi</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-brown-700/30 text-brown-100">
                            <% if (requests.length === 0) { %>
                                <tr><td colspan="7" class="px-4 py-10 text-center text-brown-300">Belum ada pengajuan Absensi.</td></tr>
                            <% } %>
                            <% requests.forEach(item => { %>
                                <% const meta = statusMeta(item.status); %>
                                <tr class="align-top hover:bg-dark-700/40">
                                    <td class="px-4 py-3">
                                        <div class="font-semibold text-white"><%= item.nama_karyawan %></div>
                                        <div class="text-xs text-brown-300">NIK <%= item.nik %></div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <div><%= typeLabel(item.jenis) %> / <%= categoryLabel(item.kategori) %></div>
                                        <% if (String(item.leave_type) === 'urgent') { %>
                                            <span class="mt-1 inline-block rounded-full bg-orange-900/60 px-2 py-0.5 text-[10px] font-semibold text-orange-200">URGENT</span>
                                        <% } else { %>
                                            <span class="mt-1 inline-block rounded-full bg-blue-900/50 px-2 py-0.5 text-[10px] font-semibold text-blue-200">PLANNED</span>
                                        <% } %>
                                    </td>
                                    <td class="px-4 py-3">
                                        <div><%= formatDateID(item.tanggal_mulai) %> s/d <%= formatDateID(item.tanggal_selesai) %></div>
                                        <% if (item.jam_mulai && item.jam_selesai) { %>
                                            <div class="text-xs text-brown-300"><%= String(item.jam_mulai).substring(0,5) %> - <%= String(item.jam_selesai).substring(0,5) %></div>
                                        <% } %>
                                    </td>
                                    <td class="px-4 py-3">
                                        <% if (item.kategori === 'full_day' && !item.jam_mulai && !item.jam_selesai) { %>
                                            <%= Math.max(1, Math.round((item.durasi_menit || 0) / (8 * 60))) %> hari
                                        <% } else { %>
                                            <%= item.durasi_menit %> menit
                                        <% } %>
                                    </td>
                                    <td class="px-4 py-3">
                                        <% if (item.nama_pengganti) { %>
                                            <div class="font-medium text-white"><%= item.nama_pengganti %></div>
                                            <% if (item.approved_pengganti_at) { %>
                                                <div class="text-xs text-green-200">Disetujui pengganti: <%= formatDateID(item.approved_pengganti_at) %></div>
                                            <% } %>
                                            <% if (item.catatan_pengganti) { %>
                                                <div class="mt-1 text-xs text-brown-300"><%= item.catatan_pengganti %></div>
                                            <% } %>
                                        <% } else { %>
                                            <span class="text-brown-400">-</span>
                                        <% } %>
                                    </td>
                                    <td class="px-4 py-3">
                                        <div class="mb-1">
                                            <span class="rounded-full px-3 py-1 text-xs <%= meta.className %>"><%= meta.label %></span>
                                        </div>
                                        <div class="text-xs text-brown-300"><%= item.nama_approver || '-' %></div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <div class="mb-2 text-sm text-brown-200"><%= item.alasan %></div>
                                        <% if (item.lampiran) { %>
                                            <div class="mb-3">
                                                <a href="<%= uploadUrl(item.lampiran) %>" target="_blank" class="inline-flex items-center gap-2 rounded border border-brown-700/40 px-3 py-1 text-xs text-brown-200 hover:text-white hover:bg-dark-700">
                                                    <i class="fas fa-paperclip"></i>Lihat Lampiran
                                                </a>
                                            </div>
                                        <% } %>
                                        <% if (canManagerApprove(item.status) && isManagerRole) { %>
                                            <form action="/admin/absensi/<%= item.id %>/approve" method="POST" class="space-y-2 approval-form" data-id="<%= item.id %>">
                                                <div class="flex items-center gap-4 rounded border border-brown-700/40 bg-dark-700 px-3 py-2 text-sm">
                                                    <label class="inline-flex items-center gap-2 cursor-pointer">
                                                        <input type="radio" name="decision_<%= item.id %>" value="approve" checked class="text-green-600 focus:ring-green-500">
                                                        <span class="text-green-200 font-medium">Terima</span>
                                                    </label>
                                                    <label class="inline-flex items-center gap-2 cursor-pointer">
                                                        <input type="radio" name="decision_<%= item.id %>" value="reject" class="text-red-600 focus:ring-red-500">
                                                        <span class="text-red-200 font-medium">Tolak</span>
                                                    </label>
                                                </div>

                                                <textarea name="approval_notes" rows="2" placeholder="Catatan persetujuan" class="approval-field w-full rounded border border-brown-700/40 bg-dark-700 px-3 py-2 text-sm text-white"></textarea>
                                                <textarea name="rejection_reason" rows="2" placeholder="Alasan penolakan" class="rejection-field hidden w-full rounded border border-brown-700/40 bg-dark-700 px-3 py-2 text-sm text-white"></textarea>

                                                <button type="submit" class="approval-submit rounded bg-green-700 px-3 py-2 text-sm text-white">Setujui</button>
                                            </form>
                                        <% } %>
                                        <% if (isManagerRole && String(item.leave_type) === 'urgent' && String(item.status) === 'disetujui') { %>
                                            <form action="/admin/absensi/<%= item.id %>/assign-pengganti" method="POST" class="mt-2 space-y-2 rounded border border-orange-700/40 bg-dark-700 px-3 py-2">
                                                <div class="text-xs font-semibold text-orange-200"><%= item.nama_pengganti ? 'Ganti pengganti (urgent)' : 'Tentukan pengganti (urgent)' %></div>
                                                <select name="id_pengganti" required class="w-full rounded border border-brown-700/40 bg-dark-800 px-2 py-1 text-sm text-white">
                                                    <option value="">-- pilih pengganti --</option>
                                                    <% employeeList.forEach(k => { %>
                                                        <% if (Number(k.id) !== Number(item.id_karyawan)) { %>
                                                            <option value="<%= k.id %>" <%= Number(item.id_pengganti) === Number(k.id) ? 'selected' : '' %>><%= k.nama %> (<%= k.nik %>)<% if (k.nama_shift) { %> — <%= k.nama_shift %><% if (k.shift_masuk) { %> <%= k.shift_masuk %>-<%= k.shift_keluar %><% } %><% } else if (k.jadwal_kerja) { %> — <%= k.jadwal_kerja %><% } %></option>
                                                        <% } %>
                                                    <% }) %>
                                                </select>
                                                <input type="text" name="catatan" placeholder="Catatan (opsional)" class="w-full rounded border border-brown-700/40 bg-dark-800 px-2 py-1 text-xs text-white">
                                                <button type="submit" class="rounded bg-orange-700 px-3 py-1.5 text-sm text-white">Simpan Pengganti</button>
                                            </form>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <div class="mt-4 flex flex-col gap-2 text-sm text-brown-300 sm:flex-row sm:items-center sm:justify-between">
                    <div>Menampilkan <%= pageInfo.startItem %>-<%= pageInfo.endItem %> dari <%= pageInfo.totalItems %> data</div>
                    <div class="flex items-center gap-2">
                        <a href="/admin/absensi?page=<%= pageInfo.prevPage %><%= queryQ %>" class="rounded border border-brown-700/40 px-3 py-1 <%= pageInfo.hasPrev ? 'text-brown-200 hover:bg-dark-700' : 'pointer-events-none opacity-40 text-brown-500' %>">Sebelumnya</a>
                        <span class="text-brown-200">Hal <%= pageInfo.page %>/<%= pageInfo.totalPages %></span>
                        <a href="/admin/absensi?page=<%= pageInfo.nextPage %><%= queryQ %>" class="rounded border border-brown-700/40 px-3 py-1 <%= pageInfo.hasNext ? 'text-brown-200 hover:bg-dark-700' : 'pointer-events-none opacity-40 text-brown-500' %>">Berikutnya</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
        document.querySelectorAll('.approval-form').forEach((form) => {
            const id = form.dataset.id;
            const approveRadio = form.querySelector(`input[name="decision_${id}"][value="approve"]`);
            const rejectRadio = form.querySelector(`input[name="decision_${id}"][value="reject"]`);
            const approvalField = form.querySelector('.approval-field');
            const rejectionField = form.querySelector('.rejection-field');
            const submitBtn = form.querySelector('.approval-submit');

            const syncState = () => {
                const isReject = rejectRadio.checked;
                form.action = isReject
                    ? `/admin/absensi/${id}/reject`
                    : `/admin/absensi/${id}/approve`;

                approvalField.classList.toggle('hidden', isReject);
                rejectionField.classList.toggle('hidden', !isReject);

                if (isReject) {
                    approvalField.value = '';
                    submitBtn.textContent = 'Tolak';
                    submitBtn.classList.remove('bg-green-700');
                    submitBtn.classList.add('bg-red-700');
                } else {
                    rejectionField.value = '';
                    submitBtn.textContent = 'Setujui';
                    submitBtn.classList.remove('bg-red-700');
                    submitBtn.classList.add('bg-green-700');
                }
            };

            approveRadio.addEventListener('change', syncState);
            rejectRadio.addEventListener('change', syncState);
            syncState();
        });
    </script>
</body>
</html>
