# Environment Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_database_password
DB_NAME=presensi_fleur_atelier
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-separate-refresh-token-secret-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Session Configuration
SESSION_SECRET=your_secret_key_here
SESSION_MAX_AGE_MS=86400000

# API Configuration
API_BASE_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
CORS_ORIGIN=*

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/faces
UPLOAD_STORAGE=local
BLOB_READ_WRITE_TOKEN=

# Security Configuration
BCRYPT_ROUNDS=10

# Face Recognition Configuration (CNN / face-api embedding 128 dimensi)
# Ambang jarak Euclidean antar embedding (lebih kecil = lebih ketat; default face-api 0.6)
FACE_MATCH_DISTANCE=0.6
# Confidence minimum deteksi wajah (SSD MobileNet v1)
FACE_DETECTION_MIN_CONFIDENCE=0.5
# Opsional: path folder model face-api (default: model bawaan paket di node_modules)
# FACE_MODELS_PATH=

# Location Configuration
DEFAULT_OFFICE_LAT=-6.200000
DEFAULT_OFFICE_LNG=106.816666
DEFAULT_OFFICE_RADIUS=100

# Development Settings
DEBUG=true
LOG_LEVEL=debug

# Google Maps API (untuk peta di admin panel)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Email Verification / SMTP
MAIL_FROM=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
